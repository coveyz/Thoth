# ============================================================
# Thoth Server
# ============================================================

# Express Server 监听端口。
# Web 的 Vite proxy 默认把 /api 转发到 http://localhost:3001。
PORT=3001
# 允许访问 Server 的前端 Origin
CORS_ORIGIN=http://localhost:5173


# ============================================================
# Chat Provider
# ============================================================

# Thoth 使用 OpenAI-compatible Chat API。
#
# 当 THOTH_API_KEY 为空时：
# - 自动使用内置 Fake Provider
# - 不访问外部网络
# - 不产生 API 费用
# - 适合本地开发和自动回归
#
# 当 THOTH_API_KEY 有值时：
# - 使用真实 DeepSeek/OpenAI-compatible Provider
THOTH_BASE_URL=https://api.deepseek.com
THOTH_API_KEY=
THOTH_MODEL=deepseek-chat


# ============================================================
# Embedding Provider
# ============================================================
# RAG 使用独立的 OpenAI-compatible Embedding API。
#
# 注意：
# Fake Chat Provider 不等于 Fake Embedding Provider。
# THOTH_EMBEDDING_API_KEY 为空时：
# - 普通聊天和工具调用仍可正常使用
# - 开启 RAG 会返回 EMBEDDING_ERROR
#
# 下面是 OpenAI-compatible 默认示例。
THOTH_EMBEDDING_BASE_URL=https://api.openai.com/v1
THOTH_EMBEDDING_API_KEY=
THOTH_EMBEDDING_MODEL=text-embedding-3-small

# 阿里云 DashScope OpenAI-compatible 示例：
# THOTH_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# THOTH_EMBEDDING_API_KEY=your_dashscope_api_key
# THOTH_EMBEDDING_MODEL=text-embedding-v4


# ============================================================
# Timeouts (milliseconds)
# ============================================================
# 最终回答流在多少毫秒内必须产生第一个 Token。
THOTH_FIRST_TOKEN_TIMEOUT_MS=10000
# 从请求开始到结束的整体超时时间。
THOTH_OVERALL_TIMEOUT_MS=60000
# SSE 心跳发送间隔，用于避免代理把连接当作空闲连接断开。
THOTH_PING_INTERVAL_MS=15000